DJANGO_SECRET_KEY=replace-in-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DATABASE_PATH=/app/data/db.sqlite3
OSRM_BASE_URL=http://osrm:5000
OSRM_TIMEOUT_SECONDS=45
ROUTE_CACHE_SECONDS=86400
PLAN_CACHE_SECONDS=86400
STATION_CORRIDOR_MILES=5
DJANGO_CACHE_BACKEND=django_redis.cache.RedisCache
DJANGO_CACHE_LOCATION=redis://redis:6379/1
RESPONSE_ROUTE_SIMPLIFY_TOLERANCE=0.002
RESPONSE_ROUTE_MAX_POINTS=1000
